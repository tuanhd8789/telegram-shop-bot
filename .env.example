# ================================================
# Starizzi Shop Bot - Cấu hình môi trường
# ================================================
# Copy file này thành .env và điền thông tin:
#   cp .env.example .env
# ================================================

# Telegram Bot Token (lấy từ @BotFather trên Telegram)
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID (gửi /myid cho bot để lấy ID)
ADMIN_ID=your_telegram_id_here

# ================================================
# Ngân hàng 1 (bắt buộc) - Thanh toán QR VietQR
# ================================================
# Tra mã BIN tại: https://www.vietqr.io/danh-sach-ngan-hang
BANK_BIN=970422
BANK_ACCOUNT=your_bank_account_number
BANK_ACCOUNT_NAME=YOUR_FULL_NAME
BANK_NAME=MB

# ================================================
# Ngân hàng 2 (tùy chọn - cho khách chọn bank)
# ================================================
# Bỏ comment để bật ngân hàng thứ 2
# BANK2_BIN=970436
# BANK2_ACCOUNT=your_second_bank_account
# BANK2_ACCOUNT_NAME=YOUR_FULL_NAME
# BANK2_NAME=VCB

# ================================================
# Health check / SePay webhook (tùy chọn)
# ================================================
# Dùng HMAC-SHA256, tối thiểu 32 ký tự. Không dùng SePay API Token tại đây.
# SEPAY_WEBHOOK_SECRET=generate_a_random_secret_and_store_it_only_in_the_environment
# SEPAY_SIGNATURE_TOLERANCE_SECONDS=300
HEALTH_BIND_ADDRESS=127.0.0.1
HEALTH_PORT=3000

# ================================================
# Sao lưu SQLite tự động
# ================================================
BACKUP_DIR=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ================================================
# Thông tin Shop
# ================================================
SHOP_NAME=My Shop
SUPPORT_CONTACT=@your_telegram_username

# ================================================
# Trợ lý AI chỉ dành cho admin (tùy chọn)
# ================================================
# API key chỉ đặt trong .env trên server; không gửi qua issue/chat hoặc commit vào Git.
# AI_BASE_URL có thể là gốc provider (bot tự thêm /v1/chat/completions).
# Nếu provider chạy trên Docker host, dùng host.docker.internal thay cho 127.0.0.1.
# AI_ENABLED=true
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=your_server_side_api_key
# AI_MODEL=your_model_name
# AI_API_MODE=chat_completions
# AI_TIMEOUT_MS=45000
# AI_MAX_TOKENS=700

# ================================================
# Google Sheet Sync (tùy chọn)
# ================================================
# 1. Mở Google Sheet → File → Chia sẻ → Xuất bản lên web → Xuất bản
# 2. Copy Sheet ID từ URL: docs.google.com/spreadsheets/d/[SHEET_ID]/edit
# GOOGLE_SHEET_ID=your_google_sheet_id
# SHEET_SYNC_INTERVAL=5
